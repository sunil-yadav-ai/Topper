PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/student_resource_sharing
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
JWT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-4.1-mini
OPENAI_SYLLABUS_MODEL=gpt-4.1-mini
OPENAI_VERIFICATION_MODEL=gpt-4.1-mini
ACADEMIC_REFERENCE_DOMAINS=openstax.org,nist.gov,mathworld.wolfram.com,chem.libretexts.org,physicsclassroom.com,khanacademy.org
MIN_VERIFIABLE_STATEMENTS=5
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OCR_ENCRYPTION_KEY=
# Initial finite platform point allocation, set before first reward-budget use.
REWARD_BUDGET_POINTS=10000
REWARD_POINTS_HANDWRITTEN_NOTE=10
REWARD_POINTS_PYQ=8
REWARD_POINTS_VERIFIED_CORRECTION=5
REWARD_POINTS_HIGH_QUALITY_RESOURCE=15

# Set these temporarily in backend/.env to provision the initial admin, then remove them.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
